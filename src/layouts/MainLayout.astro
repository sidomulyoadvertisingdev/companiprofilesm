---
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
import ChatWidget from "../components/ChatWidget.jsx";
import "../styles/index.css";
import { site } from "../data/site.js";

const {
  title = "Sidomulyo Advertising — Strategic Branding & Full-Service Advertising Agency",
  description = "Sidomulyo Advertising adalah perusahaan Strategic Branding Partner dan Full-Service Advertising Agency. Spesialis brand strategy, creative design, kampanye periklanan, corporate branding, dan produksi presisi.",
  image = "/hero-product.webp",
} = Astro.props;
---

<!doctype html>
<html lang="id" suppressHydrationWarning>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />


    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="canonical" href={Astro.url} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AdvertisingAgency",
      name: "Sidomulyo Advertising",
      alternateName: "Sidomulyo Agency & Branding Partner",
      image: "https://sidomulyo-advertising.com/sm-logo.png",
      url: "https://sidomulyo-advertising.com",
      telephone: `+${site.phone}`,
      email: site.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: site.address.country,
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: site.geo.latitude,
        longitude: site.geo.longitude,
      },
      areaServed: site.serviceArea,
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Layanan Advertising & Strategic Branding",
        itemListElement: [
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Brand Strategy & Positioning" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Creative & Visual Design" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Advertising Campaigns (OOH & Digital)" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Corporate Branding & Environmental Signage" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Production & Precision Execution Support" } },
        ],
      },
    })} />
  </head>

  <body class="bg-white text-[#1d1d1f] dark:bg-[#0a0a1a] dark:text-slate-200 transition-colors duration-300">
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <Navbar client:load />
    <slot />
    <Footer client:load />
    <ChatWidget client:load />
    <script is:inline src="/tracker.js" defer></script>
  </body>
</html>
