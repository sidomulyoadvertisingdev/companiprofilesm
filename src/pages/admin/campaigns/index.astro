---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdCampaignAdmin from "../../../react-pages/AdCampaignAdmin.jsx";
import { ensureAdCampaignSchema } from "../../../lib/ad-campaigns.js";

// Page protection for /admin/* is already handled globally by src/middleware.js.
await ensureAdCampaignSchema();

const admin = Astro.locals.admin;
const googleMapsApiKey = process.env.GOOGLE_MAPS_API_KEY || "";
---

<AdminLayout title="Ad Campaigns - Sidomulyo Advertising CMS">
  <AdCampaignAdmin client:load admin={admin} googleMapsApiKey={googleMapsApiKey} />
</AdminLayout>
