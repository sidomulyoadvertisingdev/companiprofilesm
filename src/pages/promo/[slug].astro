---
export const prerender = false;

import AdCampaignLayout from "../../layouts/AdCampaignLayout.astro";
import AdCampaignLanding from "../../react-pages/AdCampaignLanding.jsx";
import { ensureAdCampaignSchema, getAdCampaignBySlug } from "../../lib/ad-campaigns.js";

await ensureAdCampaignSchema();

const { slug } = Astro.params;
const campaign = await getAdCampaignBySlug(slug);

if (!campaign) {
  return new Response("Not found", { status: 404 });
}

const title = campaign.metaTitle || campaign.title;
const description = campaign.metaDescription || campaign.heroSubtext || "";
const image = campaign.ogImage || campaign.heroImage || "/hero-product.webp";
const canonicalUrl = campaign.canonicalUrl || Astro.url.href;
const siteOrigin = Astro.url.origin;

// Structured data (JSON-LD), built from the same campaign row the page
// already renders — no separate content to keep in sync. Deliberately does
// NOT emit Review/AggregateRating markup: the testimonials section can
// contain placeholder/unverified quotes (see the seed script's warning),
// and Google's structured-data policy requires genuine, verifiable reviews
// for that markup — emitting it here would risk a manual action.
const sections = Array.isArray(campaign.sections) ? campaign.sections : [];
const faqItems = (sections.find((s) => s.type === "faq")?.items || []).filter(
  (it) => it.active !== false && it.question && it.answer
);
const areaItems = (sections.find((s) => s.type === "areas")?.items || []).filter(
  (it) => it.active !== false && it.title
);

const graph = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Beranda", item: `${siteOrigin}/` },
      { "@type": "ListItem", position: 2, name: campaign.title, item: canonicalUrl },
    ],
  },
  {
    "@type": "Service",
    name: campaign.title,
    description,
    url: canonicalUrl,
    ...(areaItems.length ? { areaServed: areaItems.map((it) => it.title) } : {}),
    provider: {
      "@type": "Organization",
      name: "Sidomulyo Advertising",
      url: siteOrigin,
    },
    ...(campaign.formEnabled
      ? {
          offers: {
            "@type": "Offer",
            price: "0",
            priceCurrency: "IDR",
            availability: "https://schema.org/InStock",
            url: canonicalUrl,
            description: campaign.primaryCtaText || "Free sample",
          },
        }
      : {}),
  },
];

if (faqItems.length) {
  graph.push({
    "@type": "FAQPage",
    mainEntity: faqItems.map((it) => ({
      "@type": "Question",
      name: it.question,
      acceptedAnswer: { "@type": "Answer", text: it.answer },
    })),
  });
}

const structuredData = { "@context": "https://schema.org", "@graph": graph };
---

<AdCampaignLayout
  title={title}
  description={description}
  image={image}
  canonicalUrl={canonicalUrl}
  accent={campaign.accentColor || "#0A4DA6"}
  noindex={campaign.noindex}
  structuredData={structuredData}
>
  <AdCampaignLanding client:load campaign={campaign} />
</AdCampaignLayout>
