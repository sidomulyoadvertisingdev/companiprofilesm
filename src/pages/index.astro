---
import MainLayout from "../layouts/MainLayout.astro";
import { getSite, getStats, getServices, getPortfolio, getPartners, getTestimonials, getProducts } from "../lib/queries.js";
import Hero from "../components/Hero.jsx";
import GlobeShowcase from "../components/ui/GlobeShowcase.jsx";
import Services from "../components/Services.jsx";
import WhyUs from "../components/WhyUs.jsx";
import Process from "../components/Process.jsx";
import Portfolio from "../components/Portfolio.jsx";
import ClientsNetwork from "../components/ClientsNetwork.jsx";
import Testimonials from "../components/Testimonials.jsx";
import CTA from "../components/CTA.jsx";

const site = await getSite();
const stats = await getStats();
const services = await getServices();
const portfolio = await getPortfolio();
const partners = await getPartners();
const testimonials = await getTestimonials();
---

<MainLayout
  title="Sidomulyo Advertising — Strategic Branding & Full-Service Advertising Agency"
  description="Sidomulyo Advertising adalah perusahaan Strategic Branding Partner dan Full-Service Advertising Agency. Spesialis brand strategy, creative design, kampanye periklanan, corporate branding, dan produksi presisi."
>
  <main class="pt-0 bg-white dark:bg-[#09090b] text-slate-900 dark:text-slate-100 transition-colors duration-300">
    {/* 1. HERO */}
    <div class="relative">
      <Hero client:load initialData={site}>
        <GlobeShowcase client:only="react" />
      </Hero>
    </div>

    {/* 2. TRUST / CREDIBILITY */}
    <ClientsNetwork client:load initialData={partners} />

    {/* 3. SERVICES (REPOSITIONED) */}
    <Services client:load initialData={services} />

    {/* 4. WHY US */}
    <WhyUs client:load />

    {/* 5. PROCESS */}
    <Process client:load />

    {/* 6. PORTFOLIO */}
    <Portfolio client:load initialData={portfolio} />

    {/* 7. TESTIMONIALS */}
    <Testimonials client:load initialData={testimonials} />

    {/* 8. CTA */}
    <CTA client:load initialData={site} />
  </main>
</MainLayout>


